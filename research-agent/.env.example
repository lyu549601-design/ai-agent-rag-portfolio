# DeepSeek（必填，使用 OpenAI 兼容接口）
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 存储后端：postgres 为正式环境，memory 仅用于本地冒烟/CI
STORAGE_BACKEND=postgres

# 本机 Docker 服务端口刻意避开已有项目
POSTGRES_URL=postgresql://postgres:password@localhost:5433/research_agent
REDIS_URL=redis://localhost:6380/0

# 本地中文向量模型；评估时可切换为 hash 做离线冒烟测试
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# 研究参数
RETRIEVAL_TOP_K=5
MAX_REVIEW_RETRIES=1
LLM_TEMPERATURE=0.2